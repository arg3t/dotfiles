#!/usr/bin/env bash

set -u
script_path=$(readlink -f -- "${BASH_SOURCE[0]}")
script_dir=$(dirname -- "$script_path")
repo_root=$(cd -- "$script_dir/../../.." && pwd)


battery_text=$("$repo_root/.local/bin/status-bar/battery" 2>/dev/null || true)
plain_battery=$(printf '%s' "$battery_text" | sed -E 's/<[^>]*>//g')

if [ -x "$repo_root/.local/bin/dmenu-battery" ]; then
  power_summary=$(BATTERY=${BATTERY:-/sys/class/power_supply/BAT0} "$repo_root/.local/bin/dmenu-battery" --lines 2>/dev/null || true)
else
  power_summary=''
fi

if [ -n "$power_summary" ]; then
  tooltip="$power_summary"
else
  tooltip="Laptop battery: ${plain_battery:-n/a}"
fi

jq -cn --arg text "$battery_text" --arg tooltip "$tooltip" '{text:$text, tooltip:$tooltip}'
