{
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left"
  },
  "ssh_connections": [
    {
      "host": "arca.ssh",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/yigit.colakoglu"
          ]
        },
        {
          "paths": [
            "/home/yigit.colakoglu/universe/./"
          ]
        }
      ]
    },
    {
      "host": "arca.ssh",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/yigit.colakoglu"
          ]
        },
        {
          "paths": [
            "/home/yigit.colakoglu/.herdr/worktrees/runtime/i96-ts-sort-order/./"
          ]
        }
      ]
    }
  ],
  "agent_servers": {
    "cursor": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "nix": true,
    "toml": true,
    "dockerfile": true,
    "make": true,
    "just": true,
    "lua": true,
    "terraform": true,
    "typst": true,
    "git-firefly": true
  },
  "show_edit_predictions": true,
  "show_completions_on_input": true,
  "features": {
    "edit_prediction_provider": "copilot"
  },
  "agent": {
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-3.7-sonnet"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "buffer_font_family": "CaskaydiaCoveNFM-Regular",
  "buffer_font_size": 15,
  "ui_font_size": 16,
  "vim_mode": true,
  "load_direnv": "shell_hook",
  "theme": "Catppuccin Mocha",
  "languages": {
    "Python": {
      "formatter": {
        "external": {
          "command": "python",
          "arguments": ["-m", "ruff", "format", "-"]
        }
      }
    }
  },
  "vim": {
    "use_system_clipboard": "never"
  },
  "relative_line_numbers": "enabled"
}
