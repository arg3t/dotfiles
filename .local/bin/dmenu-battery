#!/usr/bin/env bash

set -u

BATTERY=${BATTERY:-/sys/class/power_supply/BAT0}
AC=${AC:-/sys/class/power_supply/AC}

menu_select() {
  local prompt=$1
  local lines=${2:-8}
  if command -v dmenu >/dev/null 2>&1; then
    dmenu -l "$lines" -p "$prompt"
  elif command -v bemenu >/dev/null 2>&1; then
    bemenu -l "$lines" -p "$prompt" -i
  else
    return 127
  fi
}

notify() {
  local urgency=$1 body=$2
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -u "$urgency" "Power profile" "$body"
}

run_privileged() {
  if command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  elif command -v run0 >/dev/null 2>&1; then
    run0 "$@"
  else
    return 1
  fi
}

read_file() {
  local path=$1
  [ -r "$path" ] && cat "$path" || printf ''
}

format_duration() {
  local total_minutes=$1
  local hours minutes
  hours=$((total_minutes / 60))
  minutes=$((total_minutes % 60))
  printf '%dh%02dm' "$hours" "$minutes"
}

battery_time_left() {
  local status energy_now power_now minutes
  status=$(read_file "$BATTERY/status")
  energy_now=$(read_file "$BATTERY/energy_now")
  power_now=$(read_file "$BATTERY/power_now")

  if [ "$status" != 'Discharging' ]; then
    printf 'charging / plugged in'
    return 0
  fi

  if [ -z "$energy_now" ] || [ -z "$power_now" ] || [ "$power_now" -le 0 ] 2>/dev/null; then
    printf 'unknown'
    return 0
  fi

  minutes=$((energy_now * 60 / power_now))
  format_duration "$minutes"
}

# Active TLP profile mode: performance | balanced | power-saver.
# tlp-stat -s reports "Power profile = <mode>/<AC|BAT>"; this is the only
# source that reflects a manual `tlp <profile>` override.
current_profile() {
  command -v tlp-stat >/dev/null 2>&1 || return 0
  tlp-stat -s 2>/dev/null | awk -F'= ' '/Power profile/ { split($2, a, "/"); print a[1]; exit }'
}

profile_label() {
  case "$1" in
    performance) printf 'Performance' ;;
    balanced) printf 'Balanced' ;;
    power-saver) printf 'Power Saver' ;;
    *) printf '%s' "$1" ;;
  esac
}

laptop_line() {
  local capacity
  capacity=$(read_file "$BATTERY/capacity")
  printf 'Laptop: %s%%, %s\n' "${capacity:-unknown}" "$(battery_time_left)"
}

bluetooth_batteries() {
  local mac name battery mac_upper mac_dir supply cap

  bluetoothctl devices Connected 2>/dev/null | while read -r _ mac name; do
    [ -n "${mac:-}" ] || continue
    battery=$(bluetoothctl info "$mac" 2>/dev/null | awk -F'[()]' '/Battery Percentage:/ { print $2; exit }')

    if [ -z "$battery" ]; then
      mac_upper=${mac^^}
      mac_dir=${mac_upper//:/_}
      for supply in /sys/class/power_supply/*; do
        [ -e "$supply" ] || continue
        case "$(basename "$supply")" in
          *"$mac_dir"*|*"$mac_upper"*) ;;
          *) continue ;;
        esac
        [ -r "$supply/capacity" ] || continue
        cap=$(cat "$supply/capacity" 2>/dev/null) || continue
        [ -n "$cap" ] && battery=$cap && break
      done
    fi

    [ -n "$battery" ] && printf '%s: %s%%\n' "$name" "$battery"
  done
}

airpods_battery() {
  command -v podctl >/dev/null 2>&1 || return 0
  podctl battery 2>/dev/null || true
}

# Informational (non-actionable) lines, shared by the waybar tooltip and the
# top of the interactive menu.
info_lines() {
  local bt airpods cur
  laptop_line

  cur=$(current_profile)
  [ -n "$cur" ] && printf 'Profile: %s\n' "$(profile_label "$cur")"

  bt=$(bluetooth_batteries)
  [ -n "$bt" ] && printf '%s\n' "$bt"

  airpods=$(airpods_battery)
  [ -n "$airpods" ] && printf '%s\n' "$airpods"
}

# Selectable profile entries; the active profile is marked with a leading "*".
profile_entries() {
  local cur mode
  cur=$(current_profile)
  for mode in performance balanced power-saver; do
    if [ "$mode" = "$cur" ]; then
      printf '* %s\n' "$(profile_label "$mode")"
    else
      printf '  %s\n' "$(profile_label "$mode")"
    fi
  done
}

apply_profile() {
  local label=$1 mode want now
  case "$label" in
    'Performance') mode=performance ;;
    'Balanced') mode=balanced ;;
    'Power Saver') mode=power-saver ;;
    *) return 0 ;;
  esac
  want=$mode

  if ! run_privileged tlp "$mode" >/dev/null 2>&1; then
    notify critical "Failed to run tlp (need passwordless sudo for tlp)"
    return 1
  fi

  # Verify the switch actually took effect.
  now=$(current_profile)
  if [ "$now" = "$want" ]; then
    notify normal "Now on $label"
  else
    notify critical "Requested $label but active profile is $(profile_label "${now:-unknown}")"
  fi

  # Refresh the waybar battery module (custom/battery "signal": 12).
  pgrep -x waybar >/dev/null 2>&1 && pkill -RTMIN+12 -x waybar
}

case "${1:-menu}" in
  --lines)
    info_lines
    ;;
  *)
    selection=$( { info_lines; profile_entries; } | menu_select "Battery" 10 ) || exit 0
    [ -n "$selection" ] || exit 0
    # Strip the active marker / indent, then act only on profile rows.
    label=${selection#'* '}
    label=${label#'  '}
    case "$label" in
      'Performance'|'Balanced'|'Power Saver') apply_profile "$label" ;;
    esac
    ;;
esac
