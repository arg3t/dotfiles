#!/bin/sh
# Pick a wallpaper folder by time of day and set it via awww (swww fork).
# hyprpaper 0.8.x fails EGL device enumeration on this NVIDIA GPU, so awww
# is the rendering daemon (see services.awww in nix/modules/hyprland.nix).

hour=$(date +"%-H")

morning=6
afternoon=12
night=19

if [ "$hour" -le "$morning" ]; then
  folder=evening
elif [ "$night" -le "$hour" ]; then
  folder=evening
elif [ "$afternoon" -le "$hour" ]; then
  folder=afternoon
else
  folder=morning
fi

img=$(find "$HOME/.local/backgrounds/$folder" -type f | sort -R | tail -1)
[ -n "$img" ] && exec awww img "$img"
