#!/usr/bin/env bash

set -u

menu_select() {
  local prompt=$1
  local lines=${2:-5}
  if command -v dmenu >/dev/null 2>&1; then
    dmenu -l "$lines" -p "$prompt"
  elif command -v bemenu >/dev/null 2>&1; then
    bemenu -l "$lines" -p "$prompt" -i
  else
    return 127
  fi
}

notify() {
  command -v notify-send >/dev/null 2>&1 && notify-send "Power profile" "$1"
}

run_privileged() {
  if command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  elif command -v run0 >/dev/null 2>&1; then
    run0 "$@"
  else
    return 1
  fi
}

current_profile() {
  tlp-stat -s 2>/dev/null | awk -F'= ' '/Power profile/ { print $2; exit }'
}

# Map friendly labels to tlp profile subcommands.
selection=$(printf 'Performance\nBalanced\nPower Saver\n' | menu_select "Power profile (now: $(current_profile))" 3) || exit 0
[ -n "$selection" ] || exit 0

case "$selection" in
  'Performance') mode=performance ;;
  'Balanced') mode=balanced ;;
  'Power Saver') mode=power-saver ;;
  *) exit 0 ;;
esac

if run_privileged tlp "$mode" >/dev/null 2>&1; then
  notify "Switched to $selection"
else
  notify "Failed to switch to $selection"
fi
