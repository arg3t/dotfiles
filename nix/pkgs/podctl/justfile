set dotenv-load := false

flake := "../.."
pkg := "podctl"

# Show available recipes
default:
    @just --list

# Build the package with better Nix output
build:
    nom build "{{flake}}#{{pkg}}"

# Run the built binary
run *args:
    nix run "{{flake}}#{{pkg}}" -- {{args}}

# nix-update needs a callPackage wrapper because the flake lives in ../.., not the
# repo root; a throwaway wrapper points it at package.nix and edits it in place.
# Bump to the latest release (or a pinned version), refreshing src and cargo hashes
update version="":
    #!/usr/bin/env bash
    set -euo pipefail
    wrap="$(mktemp --suffix=.nix)"
    trap 'rm -f "$wrap"' EXIT
    printf '{ pkgs ? import <nixpkgs> {} }: { %s = pkgs.callPackage %s/package.nix {}; }\n' \
      "{{pkg}}" "$PWD" >"$wrap"
    nix-update -f "$wrap" "{{pkg}}" {{ if version != "" { "--version " + version } else { "" } }}

# Format this package's Nix files
fmt:
    nixfmt package.nix
